.installed.cfg
*.egg

# Testing & Linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual Environments
.venv/
venv/
ENV/
env/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Databases & Environment Variables
*.db
*.sqlite
*.sqlite3
.env
.env.local
*.secret

# Sidetrack Data & Media Boundaries
data/private/*
!data/private/.gitkeep
data/derived/*
!data/derived/.gitkeep
data/cache/*
!data/cache/.gitkeep
media/cached/*
!media/cached/.gitkeep
*.pickle

# Experiments & Temp Files
scratch/
tmp/
*.log
